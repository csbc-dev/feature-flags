{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    // Resolve `@csbc-dev/feature-flags` to the package SOURCE, mirroring the
    // Vite alias in vite.config.ts so the typecheck and the bundle agree.
    // `paths` are resolved relative to this tsconfig (no `baseUrl` — it is
    // deprecated in TS 7.0).
    "paths": {
      "@csbc-dev/feature-flags": ["../../src/index.ts"],
      "@csbc-dev/feature-flags/server": ["../../src/server/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
