{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src"],
  // `src/auto/` is a hand-authored, ship-as-is side-effect entry (auto.js /
  // auto.min.js / auto.d.ts). It imports the COMPILED `../../dist/index.js`, so
  // it must NOT be run through `tsc` — exclude it from the emit (and from the
  // test-config that extends this one).
  "exclude": ["src/auto"]
}
